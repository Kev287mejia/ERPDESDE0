# ==============================================================================
# ETERNAL LABS - ENTERPRISE SOFTWARE DIVISION
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Clave criptográfica para firmas de sesión y protección CSRF
SECRET_KEY=django-insecure-change-me-in-production-eternal-labs-2026-core

# Modo de depuración (False en entornos de producción y staging)
DEBUG=True

# Hosts autorizados para recibir solicitudes HTTP (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Conexión a la base de datos relacional (PostgreSQL para producción / SQLite local)
# Formato PostgreSQL: postgresql://usuario:password@localhost:5432/erp_vector_db
# Formato SQLite: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Parámetros de localización
TIME_ZONE=America/Managua
LANGUAGE_CODE=es-ni

# ==============================================================================
# VECTOR ERP SAS - CLOUD PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Arquitectura: Multi-Tenant Enterprise / Nicaragua DGI-822 / BCN / Docker
# ==============================================================================

# Clave criptográfica para firmas de sesión, cookies y protección CSRF
SECRET_KEY=django-insecure-production-vector-saas-change-me-promptly-2026

# Modo de depuración (OBLIGATORIO: False en entornos de producción)
DEBUG=False

# Dominios y hosts autorizados (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,vector-erp.com.ni,app.vector-erp.com.ni

# Conexión a la base de datos relacional ACID (PostgreSQL para producción)
# Formato Docker Compose: postgresql://vector_admin:vector_secure_password_2026@db:5432/vector_erp_db
DATABASE_URL=postgresql://vector_admin:vector_secure_password_2026@db:5432/vector_erp_db

# Parámetros de Postgres para contenedor independiente
POSTGRES_DB=vector_erp_db
POSTGRES_USER=vector_admin
POSTGRES_PASSWORD=vector_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Broker de caché y mensajería Redis
REDIS_URL=redis://redis:6379/1

# Configuración Regional de Localización & Tributación Fiscal
TIME_ZONE=America/Managua
LANGUAGE_CODE=es-ni

# Parámetros de Motor Fiscal DGI & BCN Nicaragua
BCN_OFFICIAL_EXCHANGE_RATE=36.6243
DGI_DEFAULT_IVA_RATE=15.00
DGI_DEFAULT_IR_RETENTION_RATE=2.00
DGI_DEFAULT_ALCALDIA_RETENTION_RATE=1.00

# Puerto del Servidor de Aplicación
PORT=8000
